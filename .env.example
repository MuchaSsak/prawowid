# Prawdowid: environment variables template.
# Copy to .env and fill in. Never commit .env or real values (rule 11).
# Only secrets live here. All other settings (models, routing, limits, retention)
# are defaults in code (decisions/003-config-in-code.md).

# LLM gateway (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# EUvsDisinfo MCP token (from the organizer)
EUVSDISINFO_TOKEN=

# Optional: override a model default without a code change (rule 19), e.g.
# MODEL_EVIDENCE_ASSESSMENT=mistralai/mistral-large-2512
