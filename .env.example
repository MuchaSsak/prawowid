# Prawdowid: environment variables template.
# Copy to .env and fill in. Never commit .env or real values (rule 11).
# Docs: .agents/project-info/architecture/ (model-selection.md, api-endpoints-verified.md)

# --- App ---------------------------------------------------------------
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# Answer language policy (product/response-contract.md): Polish is the default (MVP requirement)
DEFAULT_ANSWER_LANGUAGE=pl
SUPPORTED_ANSWER_LANGUAGES=pl,en,uk

# --- LLM gateway: OpenRouter --------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Provider routing (GDPR): no training on our data, zero data retention, EU endpoint for Mistral
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_PROVIDER_ONLY=mistral/eu

# Models per pipeline step (swappable without a rebuild, rule 19)
MODEL_CLAIM_EXTRACTION=mistralai/mistral-small-2603
MODEL_EVIDENCE_ASSESSMENT=mistralai/mistral-small-2603
MODEL_IMAGE=mistralai/mistral-small-2603
MODEL_VIDEO=google/gemini-3.1-flash-lite
MODEL_AUDIO=mistralai/voxtral-small-24b-2507
MODEL_EMBEDDINGS=baai/bge-m3
MODEL_FALLBACK=anthropic/claude-haiku-5.5

# --- Database: Supabase (EU) --------------------------------------------
# Server-side only. Never expose these to the browser (decisions/001-private-logs-schema.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
LOG_RETENTION_DAYS=30

# --- Sources --------------------------------------------------------------
# EUvsDisinfo MCP: token from the organizer (Discord DM)
EUVSDISINFO_MCP_URL=https://euvsdisinfo-mcp-server.vercel.app/mcp
EUVSDISINFO_TOKEN=
# Google Fact Check Tools API (free key from Google Cloud)
GOOGLE_FACTCHECK_API_KEY=
# Generic client name for fetching pages (no personal data here)
FETCH_USER_AGENT=PrawdowidBot/0.1 (+https://github.com/<team>/prawdowid)

# --- Channel: Discord (HTTP Interactions) --------------------------------
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# HMAC secret for the internal self-call that runs the Discord job
INTERNAL_JOB_SECRET=

# --- Moderator loop -------------------------------------------------------
# Where escalated cases are announced (e.g. a Discord channel webhook)
MODERATOR_WEBHOOK_URL=

# --- Limits ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=10
MAX_CLAIMS_PER_CHECK=8
VIDEO_MAX_SECONDS=600
VIDEO_MAX_MB=50
FETCH_TIMEOUT_MS=10000
