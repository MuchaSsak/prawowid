# Prawdomat: environment variables template.
# Copy to .env and fill in. Never commit .env or real values (rule 11).
# Only secrets live here. All other settings (models, routing, limits, retention)
# are defaults in code (decisions/003-config-in-code.md, packages/core/src/config.ts).

# LLM gateway (https://openrouter.ai/settings/keys). Required.
OPENROUTER_API_KEY=

# Google Fact Check Tools API key (Google Cloud console → APIs & Services → Credentials).
# The "Fact Check Tools API" must be ENABLED in that project. Without it, claims return
# the system state "source unavailable" instead of a verdict (scenario J).
GOOGLE_FACT_CHECK_API_KEY=

# EUvsDisinfo MCP key (https://mcp.euvsd.info/mcp). Optional: known-narrative context next to claims (packages/core/src/narratives).
EUVSDISINFO_TOKEN=

# Supabase (later, not used yet). Read by the Supabase CLI itself for link/push.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# Optional: override a model default without a code change (rule 19), e.g.
# MODEL_CLAIM_EXTRACTION=mistralai/mistral-small-2603
# MODEL_EVIDENCE_ASSESSMENT=mistralai/mistral-large-2512
# MODEL_IMAGE_EXTRACTION=mistralai/mistral-small-2603

# Optional, not secret: API port and the web origins allowed by CORS.
# PORT=8787
# WEB_ORIGINS=http://localhost:4321

# ---- Messaging bot (apps/bot) -------------------------------------------------------------
# Full list and setup per platform: apps/bot/README.md and the wiki runbook. On Vercel these go
# in the project settings, not in a file.
# PRAWDOWID_API_URL=https://prawowid.mateusz.deno.net   # not secret; default is the deployed API
# PRAWDOWID_WEB_URL=                                    # not secret; web app link in every reply
# PUBLIC_SITE_URL=                                      # not secret; web app origin at build time, for absolute og:image / og:url (link previews)
# BOT_PRIVACY_CONTACT=                                  # not secret; controller + contact e-mail for /pomoc
# PRAWDOWID_CLIENT_KEY=      # must match "bot:<key>" in the API's CLIENT_KEYS
# BOT_ID_SECRET=             # HMAC key for user pseudonyms (e.g. openssl rand -hex 32); never rotate mid-event
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID=          # the demo server, for command registration
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_VERIFY_TOKEN=

# Optional secret: enables GET /api/v1/admin/checks (the check log: masked question, time, sources,
# verdicts) with the header "Authorization: Bearer <ADMIN_TOKEN>". Leave empty to keep it disabled.
# ADMIN_TOKEN=

# ---- Vector database (scripts/, VECTOR_DB_README.md; local only) -------------------------------------
POSTGRES_DB=knowledge_base_main
POSTGRES_USER=knowledge_base
POSTGRES_PASSWORD=knowledge_base_local_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PRAWDOWID_EMBEDDING_MODEL=
PRAWDOWID_RETRIEVAL_THRESHOLD=
