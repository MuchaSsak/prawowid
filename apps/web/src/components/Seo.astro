---
/**
 * <head> metadata shared by every page: title, description, canonical, and the Open Graph /
 * Twitter tags that Discord, Messenger, WhatsApp, Slack and X read to build a link preview
 * (banner image + title + description). The image is public/og.png (source: scripts/og-image.html).
 * Link previews need absolute URLs, so set PUBLIC_SITE_URL at build time (see astro.config.mjs).
 */
interface Props {
  title: string;
  description: string;
  /** Preview title; defaults to `title`. Kept short: Discord cuts around 70 characters. */
  ogTitle?: string;
  noindex?: boolean;
}
const { title, description, ogTitle = title, noindex = false } = Astro.props;
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const url = abs(Astro.url.pathname);
const image = abs("/og.png");
const imageAlt = "Prawdomat. Sprawdź, zanim udostępnisz. Bezpłatne sprawdzanie faktów ze źródłami.";
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{Astro.site && <link rel="canonical" href={url} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#f1f0ee" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#050d1a" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Prawdomat" />
<meta property="og:locale" content="pl_PL" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
