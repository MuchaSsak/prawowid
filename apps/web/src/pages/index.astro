---
import "@fontsource-variable/inter-tight";
import "../styles/global.css";
import Seo from "../components/Seo.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8787";
---
<!doctype html>
<html lang="pl">
  <head>
    <Seo
      title="Prawdomat: sprawdź, zanim udostępnisz"
      ogTitle="Prawdomat · Sprawdź, zanim udostępnisz"
      description="Wklej wypowiedź, link, zdjęcie albo nagranie. Prawdomat sprawdza fakty i pokazuje, co mówią o tym wiarygodne źródła. Bezpłatnie."
      structuredData
    />
    <!-- The video poster is the largest paint on the first screen: fetch it before anything else. -->
    <link rel="preload" as="image" href="/video/prawdomat-bg-loop.webp" type="image/webp" fetchpriority="high" />
  </head>
  <body data-api={apiUrl}>
    <div id="test-bar" class="test-bar" role="status" hidden>
      Dev mode: dane przykładowe<span class="test-sep">·</span><span id="test-scenario"></span>
      <button type="button" id="test-off" class="test-off">Wyłącz</button>
    </div>
    <div class="frame">
      <div class="hero-video" aria-hidden="true">
        <video id="hero-video" muted loop playsinline disablepictureinpicture preload="none" poster="/video/prawdomat-bg-loop.webp">
          <source src="/video/prawdomat-bg-loop.webm" type="video/webm" />
        </video>
      </div>
      <header class="top">
        <div class="top-row">
          <span class="brand-wrap">
            <a class="brand" href="/">
              <svg class="mark" id="mark" data-rosette="mark" viewBox="-100 -100 200 200" aria-hidden="true"></svg>
              Prawdomat
            </a>
            <button type="button" id="dev-toggle" class="dev-bubble">Dev mode?</button>
          </span>
          <div class="top-actions">
            <button type="button" id="new-chat" class="pill-btn" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              <span>Nowe pytanie</span>
            </button>
            <a class="ghost-btn" href="/admin/analityka" aria-label="Panel analityki">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
              <span class="ghost-label">Panel</span>
            </a>
          </div>
        </div>
      </header>

      <main>
        <section class="intro">
          <h1>Sprawdź, zanim udostępnisz</h1>
          <p class="lede">Wklej wypowiedź albo link, dołącz zdjęcie, film lub nagranie. Pokażemy, co mówią o tym źródła.</p>
        </section>

        <section id="thread" class="thread" aria-label="Rozmowa"></section>
        <p id="sr-status" class="sr-only" aria-live="polite"></p>

        <div id="dock" class="dock">
          <div class="dock-inner">
            <form id="check-form" class="composer" novalidate>
              <div id="attachment" class="attachment" hidden>
                <div id="attachment-media" class="attachment-media"></div>
                <div class="attachment-info">
                  <span id="attachment-kind" class="kind-chip"></span>
                  <span id="attachment-name" class="attachment-name"></span>
                  <span id="attachment-size" class="muted"></span>
                </div>
                <button type="button" id="attachment-remove" class="icon-btn" aria-label="Usuń załącznik" title="Usuń załącznik">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
              </div>

              <div class="pill-row">
                <label for="text-input" class="sr-only">Treść do sprawdzenia lub pytanie do załącznika</label>
                <textarea id="text-input" rows="1" maxlength="50000"></textarea>
                <button type="button" id="attach" class="icon-btn" aria-label="Dołącz zdjęcie, film lub nagranie" title="Dołącz zdjęcie, film lub nagranie (do 5 MB)">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 7.5l-7.8 7.8a2.1 2.1 0 003 3l8.1-8.1a4.2 4.2 0 00-6-6L5.7 12.3a6.3 6.3 0 009 9l6.3-6.3" /></svg>
                </button>
                <button type="button" id="mic" class="icon-btn mic" aria-label="Nagraj wiadomość głosową" aria-pressed="false" title="Nagraj wiadomość głosową">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0014 0M12 18v3" /></svg>
                </button>
                <button type="submit" id="submit" class="send" aria-label="Sprawdź" title="Sprawdź">
                  <span class="send-label" aria-hidden="true">Sprawdź</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
                <input id="file-input" type="file" hidden />
              </div>
            </form>

            <p id="form-error" class="form-error" role="alert" hidden></p>
            <p id="send-as" class="composer-note" aria-live="polite"></p>

          </div>
        </div>
      </main>
    </div>

    <footer class="foot">
      <p>Zachęcamy cię do weryfikowania informacji w internecie. Sprawdzaj źródła! <a href="/prywatnosc" class="text-link">Polityka Prywatności</a> · <button id="forget-session" type="button" class="text-link">Usuń dane sesji</button></p>
      <p id="toast" class="toast" role="status" hidden></p>
    </footer>

    <div id="drop-overlay" class="drop-overlay" hidden>
      <div class="drop-card">
        <strong>Upuść plik, żeby go dołączyć</strong>
        <span>Zdjęcie, film albo nagranie do 5 MB</span>
      </div>
    </div>

    <script>
      import { initApp } from "../lib/app.ts";
      import { initHeroVideo } from "../lib/hero-video.ts";
      initApp();

      // After page load: the WebGL backdrop starts (in a worker; its canvas fades in over the CSS
      // gradient) and reports whether there is a GPU. Only then do the hero video and the film grain
      // start; without a GPU they would cost seconds of CPU, so the poster stays as a still.
      const video = document.getElementById("hero-video") as HTMLVideoElement | null;
      const startEffects = () =>
        import("../lib/backdrop.ts")
          .then((m) => m.initBackdrop(document.body))
          .catch(() => "unknown" as const)
          .then((verdict) => initHeroVideo(video, verdict !== "software"));
      if (document.readyState === "complete") startEffects();
      else addEventListener("load", startEffects, { once: true });
    </script>
  </body>
</html>
