---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/inter-tight";
import "../styles/global.css";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8787";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Prawdomat: bezpłatne sprawdzanie faktów ze źródłami." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Prawdomat: sprawdź, zanim udostępnisz</title>
  </head>
  <body data-api={apiUrl}>
    <div class="frame">
      <header class="top">
        <div class="top-row">
          <a class="brand" href="/">
            <svg class="mark" id="mark" data-rosette="mark" viewBox="-100 -100 200 200" aria-hidden="true"></svg>
            Prawdomat
          </a>
          <div class="top-actions">
            <button type="button" id="new-chat" class="pill-btn" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              <span>Nowe pytanie</span>
            </button>
          </div>
        </div>
      </header>

      <main>
        <section class="intro">
          <h1>Sprawdź, zanim udostępnisz</h1>
          <p class="lede">Wklej wypowiedź albo link, dołącz zdjęcie, film lub nagranie. Pokażemy, co mówią o tym źródła.</p>
        </section>

        <section id="thread" class="thread" aria-label="Rozmowa"></section>
        <p id="sr-status" class="sr-only" aria-live="polite"></p>

        <div id="dock" class="dock">
          <div class="dock-inner">
            <form id="check-form" class="composer" novalidate>
              <div id="attachment" class="attachment" hidden>
                <div id="attachment-media" class="attachment-media"></div>
                <div class="attachment-info">
                  <span id="attachment-kind" class="kind-chip"></span>
                  <span id="attachment-name" class="attachment-name"></span>
                  <span id="attachment-size" class="muted"></span>
                </div>
                <button type="button" id="attachment-remove" class="icon-btn" aria-label="Usuń załącznik" title="Usuń załącznik">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
              </div>

              <div class="pill-row">
                <label for="text-input" class="sr-only">Treść do sprawdzenia lub pytanie do załącznika</label>
                <textarea id="text-input" rows="1" maxlength="50000"></textarea>
                <button type="button" id="attach" class="icon-btn" aria-label="Dołącz zdjęcie, film lub nagranie" title="Dołącz zdjęcie, film lub nagranie (do 5 MB)">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 7.5l-7.8 7.8a2.1 2.1 0 003 3l8.1-8.1a4.2 4.2 0 00-6-6L5.7 12.3a6.3 6.3 0 009 9l6.3-6.3" /></svg>
                </button>
                <button type="button" id="mic" class="icon-btn mic" aria-label="Nagraj wiadomość głosową" aria-pressed="false" title="Nagraj wiadomość głosową">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0014 0M12 18v3" /></svg>
                </button>
                <button type="submit" id="submit" class="send" aria-label="Sprawdź" title="Sprawdź">
                  <span class="send-label" aria-hidden="true">Sprawdź</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
                <input id="file-input" type="file" hidden />
              </div>
            </form>

            <p id="form-error" class="form-error" role="alert" hidden></p>
            <p id="send-as" class="composer-note" aria-live="polite"></p>

            <details class="settings" id="settings">
              <summary>
                <span id="mode-summary">Demo: odpowiedzi przykładowe</span>
              </summary>
              <div class="settings-body">
              <div class="seg" role="radiogroup" aria-label="Rodzaj odpowiedzi">
                <button type="button" role="radio" class="seg-btn" data-mode="mock" aria-checked="true">Demo</button>
                <button type="button" role="radio" class="seg-btn" data-mode="live" aria-checked="false">Na żywo</button>
              </div>
              <label class="scenario" id="scenario-wrap">
                <span>Scenariusz</span>
                <select id="scenario">
                  <option value="">dobierz sam</option>
                </select>
              </label>
              <p id="mode-hint" class="mode-hint"></p>
              </div>
            </details>
          </div>
        </div>
      </main>
    </div>

    <footer class="foot">
      <p>Prawdomat nie ocenia opinii i nie zastępuje własnego osądu. Zawsze otwórz cytowane źródła. Twoich plików nie zapisujemy.</p>
      <button type="button" id="forget" class="text-link">Usuń dane mojej sesji</button>
    </footer>

    <div id="drop-overlay" class="drop-overlay" hidden>
      <div class="drop-card">
        <strong>Upuść plik, żeby go dołączyć</strong>
        <span>Zdjęcie, film albo nagranie do 5 MB</span>
      </div>
    </div>

    <script>
      import { initApp } from "../lib/app.ts";
      initApp();
    </script>
  </body>
</html>
