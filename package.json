{
  "name": "prawdowid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "api:dev": "cd apps/api && deno task dev",
    "api:start": "cd apps/api && deno task start",
    "web:dev": "bun run --cwd apps/web dev",
    "web:preview": "bun run --cwd apps/web build && bun run --cwd apps/web preview",
    "bot:dev": "bun run --cwd apps/bot dev",
    "bot:console": "bun run --cwd apps/bot console",
    "bot:test": "bun run --cwd apps/bot test",
    "bot:check": "bun run --cwd apps/bot check",
    "bot:discord:commands": "bun run --cwd apps/bot discord:commands",
    "check": "turbo run check",
    "test": "deno test --allow-env --allow-net --allow-read --allow-write packages/core apps/api",
    "supabase:schemas:check": "node supabase/scripts/check-schemas.mjs",
    "supabase:migration": "node supabase/scripts/migrate.mjs --generate",
    "supabase:push": "node supabase/scripts/migrate.mjs --push",
    "supabase:deploy:edge": "node supabase/scripts/deploy-functions.mjs",
    "eval": "cd eval && deno task eval",
    "eval:quick": "cd eval && deno task eval:quick",
    "eval:organizer": "cd eval && deno task eval:organizer",
    "eval:remote": "cd eval && deno task eval:remote",
    "corpus:convert": "deno run --allow-read --allow-write scripts/convert_alert_data.ts",
    "corpus:build": "deno run --allow-read --allow-write scripts/build_corpus_index.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
